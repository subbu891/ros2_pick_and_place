<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pnp_interfaces</name>
  <version>0.1.0</version>
  <description>Messages and actions for the vision-guided pick-and-place project.</description>
  <maintainer email="your-github-email@example.com">Subrahmanyam Kodela</maintainer>
  <license>Apache-2.0</license>

  <!-- Needed to BUILD this package -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- Used by our interface files (build + run) -->
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <!-- Needed to RUN code that uses these interfaces -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Marks this as an interface package (required, or the build fails) -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
