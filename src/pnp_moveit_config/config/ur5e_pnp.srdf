<?xml version="1.0" encoding="UTF-8"?>
<robot name="ur5e_pnp">
  <!-- Planning group: chain from the base to the TCP between the fingers.
       Ending at gripper_tcp means every target pose is for the fingertip point. -->
  <group name="ur_manipulator">
    <chain base_link="base_link" tip_link="gripper_tcp"/>
  </group>
  <group name="gripper">
    <joint name="left_finger_joint"/>
    <joint name="right_finger_joint"/>
  </group>

  <!-- Named poses you can plan to by name -->
  <group_state name="home" group="ur_manipulator">
    <joint name="shoulder_pan_joint" value="0"/>
    <joint name="shoulder_lift_joint" value="-1.5708"/>
    <joint name="elbow_joint" value="1.5708"/>
    <joint name="wrist_1_joint" value="-1.5708"/>
    <joint name="wrist_2_joint" value="-1.5708"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>
  <group_state name="observe" group="ur_manipulator">
    <joint name="shoulder_pan_joint" value="-1.5708"/>
    <joint name="shoulder_lift_joint" value="-1.5708"/>
    <joint name="elbow_joint" value="1.5708"/>
    <joint name="wrist_1_joint" value="-1.5708"/>
    <joint name="wrist_2_joint" value="-1.5708"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="left_finger_joint" value="0.035"/>
    <joint name="right_finger_joint" value="0.035"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="left_finger_joint" value="0.021"/>
    <joint name="right_finger_joint" value="0.021"/>
  </group_state>

  <end_effector name="gripper_eef" parent_link="gripper_tcp" group="gripper"
                parent_group="ur_manipulator"/>

  <!-- Link pairs that touch by design or can never collide: skip checking them.
       Without these, MoveIt sees the robot "colliding with itself" all the time. -->
  <disable_collisions link1="pedestal" link2="base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="pedestal" link2="shoulder_link" reason="Never"/>
  <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_3_link" link2="gripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link" link2="gripper_base_link" reason="Never"/>
  <disable_collisions link1="gripper_base_link" link2="left_finger_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base_link" link2="right_finger_link" reason="Adjacent"/>
  <disable_collisions link1="left_finger_link" link2="right_finger_link" reason="Never"/>
  <disable_collisions link1="wrist_3_link" link2="left_finger_link" reason="Never"/>
  <disable_collisions link1="wrist_3_link" link2="right_finger_link" reason="Never"/>
</robot>
