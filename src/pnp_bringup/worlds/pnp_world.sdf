<?xml version="1.0"?>
<sdf version="1.8">
  <world name="pnp_world">
    <!-- 1 ms physics steps, real-time speed -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo "systems": physics, spawning via commands, scene for the GUI,
         sensors (needed for the camera in Step 13) -->
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Table: top surface at z = 0.40 m, level with the robot base -->
    <model name="table">
      <static>true</static>
      <pose>0.55 0 0 0 0 0</pose>
      <link name="top">
        <pose>0 0 0.38 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.8 1.2 0.04</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 1.2 0.04</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="base">
        <pose>0 0 0.18 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.7 1.1 0.36</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.7 1.1 0.36</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
