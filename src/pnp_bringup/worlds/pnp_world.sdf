<?xml version="1.0"?>
<sdf version="1.8">
  <world name="pnp_world">
    <!-- 1 ms physics steps, real-time speed -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo "systems": physics, spawning via commands, scene for the GUI,
         sensors (needed for the camera in Step 13) -->
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Table: top surface at z = 0.40 m, level with the robot base -->
    <model name="table">
      <static>true</static>
      <pose>0.55 0 0 0 0 0</pose>
      <link name="top">
        <pose>0 0 0.38 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.8 1.2 0.04</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 1.2 0.04</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="base">
        <pose>0 0 0.18 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.7 1.1 0.36</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.7 1.1 0.36</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>
        <!-- ===== Bins (centres at y = 0.35, on the table top z = 0.40) ===== -->
    <include><uri>model://pnp_bin</uri><name>bin_red</name>  <pose>0.30 0.35 0.40 0 0 0</pose></include>
    <include><uri>model://pnp_bin</uri><name>bin_green</name><pose>0.45 0.35 0.40 0 0 0</pose></include>
    <include><uri>model://pnp_bin</uri><name>bin_blue</name> <pose>0.60 0.35 0.40 0 0 0</pose></include>

    <!-- ===== Cubes (centre z = 0.42: table top + half a cube); last value = yaw ===== -->
    <include><uri>model://cube_red</uri>  <name>cube_red_0</name>  <pose>0.40 -0.20 0.421 0 0  0.3</pose></include>
    <include><uri>model://cube_red</uri>  <name>cube_red_1</name>  <pose>0.62  0.05 0.421 0 0 -0.5</pose></include>
    <include><uri>model://cube_green</uri><name>cube_green_0</name><pose>0.52 -0.08 0.421 0 0  0.0</pose></include>
    <include><uri>model://cube_green</uri><name>cube_green_1</name><pose>0.35  0.10 0.421 0 0  0.7</pose></include>
    <include><uri>model://cube_blue</uri> <name>cube_blue_0</name> <pose>0.65 -0.25 0.421 0 0  0.2</pose></include>
    <include><uri>model://cube_blue</uri> <name>cube_blue_1</name> <pose>0.45 -0.32 0.421 0 0 -0.3</pose></include>

    <!-- ===== Overhead RGB-D camera, 1 m above the table, looking straight down ===== -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>0.50 0.05 1.40 0 1.5708 0</pose>
      <link name="link">
        <sensor name="rgbd" type="rgbd_camera">
          <topic>camera</topic>
          <ignition_frame_id>camera_optical_frame</ignition_frame_id>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>3.0</far></clip>
            <depth_camera><clip><near>0.1</near><far>3.0</far></clip></depth_camera>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
